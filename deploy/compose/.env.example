# deploy/compose/.env — copy to .env, fill in, keep it out of version control (0600).
# Every variable is described in deploy/README.md. Values here are placeholders, not working keys.

# --- Release and region --------------------------------------------------------------------------
SHOGUN_VERSION=0.1.0
# The region this host serves. One host (or fleet) per region; nothing crosses regions.
SHOGUN_REGION=ap-northeast-1
# Where the gateway port is published on the host (put a TLS-terminating proxy in front).
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787

# --- Postgres (gateway ledger) -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-superuser
GATEWAY_DB_PASSWORD=change-me-gateway-role

# --- Gateway (apps/api/src/boot.ts) --------------------------------------------------------------
# Your own provider key: model calls go from this host straight to the provider.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=
BATCH_PROVIDER=openai
# base64 of the licence API's 32-byte Ed25519 public key (packages/config/license-public-key.json).
LICENSE_PUBKEY_B64=replace-with-base64-public-key
# Global daily spend breaker, USD per UTC day.
DAILY_SPEND_CAP_USD=50
AGENT_API_ENABLED=0
AGENT_POW_SECRET=
PUBLIC_BASE_URL=
METRICS_TOKEN=
# Approvals (E15): the same signing key on the sidecar and the gateway (>= 32 characters), and the
# webhook signing secret the gateway requires once the signing key is set.
SHOGUN_APPROVAL_SIGNING_KEY=
WEBHOOK_SIGNING_SECRET=
SHOGUN_APPROVAL_BASE_URL=
# The router's service token (E32, E48), when a router settles runs and fetches connector tokens
# here: >= 32 characters, the same value as the router's. Empty = those routes are not served.
ROUTER_SETTLEMENT_TOKEN=
# The hosted connect flow (E50): >= 32 characters; seals connect links and OAuth states. Needs the
# relay's bearer source, SHOGUN_ADMIN_TOKEN and the sidecar's SHOGUN_CONNECT_* below.
CONNECTOR_CONNECT_SECRET=
# Several hosts splitting the principals only (deploy/README.md §5.2): `<index>/<count>`.
SHOGUN_SHARD=
# OpenTelemetry (E37): body-free request spans to an OTLP/HTTP collector (https, or http to
# loopback). Empty endpoints = off. Headers are `k=v,k2=v2` (a secret; sent to the collector only).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=shogunagent-gateway
OTEL_TRACES_SAMPLER_ARG=1

# --- Sidecar ------------------------------------------------------------------------------------
# The gateway's derived bearers (E34): >= 32 characters. Compose hands the same value to the
# gateway (SHOGUN_SIDECAR_BEARER_SECRET) and the sidecar. With it, SHOGUN_PRINCIPAL_TOKENS can stay
# empty (threat model R4). SHOGUN_PRINCIPAL_TOKENS and SHOGUN_ADMIN_TOKEN also reach the gateway
# (as SHOGUN_SIDECAR_PRINCIPAL_TOKENS and SHOGUN_SIDECAR_ADMIN_TOKEN).
SHOGUN_SIDECAR_BEARER_SECRET=
# principal:token[:agent_id],... : a fixed list (BYOC, evaluation). A listed token wins.
SHOGUN_PRINCIPAL_TOKENS=
SHOGUN_ADMIN_TOKEN=
SHOGUN_MULTI_MAX_OPEN=64

# Hosted connector credentials (E50, deploy/README.md section 3.3). The callback is
# <PUBLIC_BASE_URL>/v1/connectors/callback, registered with each vendor. A Google "Web application"
# client needs its secret; Slack and Linear secrets are optional for PKCE apps.
SHOGUN_CONNECT_REDIRECT_URI=
SHOGUN_CONNECT_GOOGLE_CLIENT_ID=
SHOGUN_CONNECT_GOOGLE_CLIENT_SECRET=
SHOGUN_CONNECT_SLACK_CLIENT_ID=
SHOGUN_CONNECT_SLACK_CLIENT_SECRET=
SHOGUN_CONNECT_LINEAR_CLIENT_ID=
SHOGUN_CONNECT_LINEAR_CLIENT_SECRET=
# A GitHub App with "Enable Device Flow" on; connected with a code the human types at
# github.com/login/device (no callback). The secret is optional (sent on refresh when set).
SHOGUN_CONNECT_GITHUB_CLIENT_ID=
SHOGUN_CONNECT_GITHUB_CLIENT_SECRET=

# Key provider: env | aws-kms | gcp-kms | vault. `env` is for evaluation only.
SHOGUN_KEY_PROVIDER=vault
SHOGUN_KMS_KEY_CACHE_SECS=300
SHOGUN_KMS_TIMEOUT_SECS=10

# aws-kms (static credentials on a plain host; on EKS use IRSA through the Helm chart)
SHOGUN_AWS_KMS_KEY_ID=
SHOGUN_AWS_KMS_REGION=
SHOGUN_AWS_KMS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# gcp-kms (a token file refreshed by your token agent, mounted into the sidecar)
SHOGUN_GCP_KMS_KEY=
SHOGUN_GCP_ACCESS_TOKEN_FILE=

# vault (Transit; https only)
VAULT_ADDR=https://vault.internal:8200
VAULT_NAMESPACE=
VAULT_TOKEN=
SHOGUN_VAULT_TRANSIT_MOUNT=transit
SHOGUN_VAULT_TRANSIT_KEY=shogunagent-principals

# env provider only (64 hex characters). Leave empty with a KMS provider.
SHOGUN_DB_KEY=

# Optional automatic review/consolidation; 0 disables, otherwise 30–3600 seconds.
# Requires each principal's stored relay credential; model calls are metered.
SHOGUN_PROCESSING_INTERVAL_SECS=0
