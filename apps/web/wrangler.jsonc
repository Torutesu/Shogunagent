// Production website. Cloudflare Workers Builds deploys main after web tests pass.
// Only these two website domains belong to this Worker; API services are separate.
{
  "name": "shogunagent-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "shogunagent.com", "custom_domain": true },
    { "pattern": "www.shogunagent.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
